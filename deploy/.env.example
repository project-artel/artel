# ARTEL self-hosted stack. install.sh writes this file with generated secrets.
# Compose reads it as-is: no quotes, no "export", no inline comments after a value.
# Generate a secret by hand with:  openssl rand -hex 32

# ---- Image selection ------------------------------------------------------
# Tag of the ghcr.io/project-artel/* images. Pin a release tag for a stable install.
ARTEL_IMAGE_TAG=latest

# ---- Public address -------------------------------------------------------
# Host port the reverse proxy listens on (HTTP). The whole product, including the admin page
# at /admin/, is served on this one origin.
ARTEL_HTTP_PORT=8088
ARTEL_HTTPS_PORT=8443
# The URL people type in a browser, without a trailing slash. Used for the allowed origin and
# the post-login redirect. Change it when you serve from a real host name.
ARTEL_PUBLIC_URL=http://localhost:8088
# Caddy site address. ":80" serves plain HTTP. A host name such as artel.example.com makes
# Caddy obtain a TLS certificate automatically (ports 80 and 443 must then reach this host).
ARTEL_SITE_ADDRESS=:80
# Set to true only when ARTEL_PUBLIC_URL is https, so cookies are sent over TLS only.
ARTEL_SECURE_COOKIE=false

# ---- Secrets (generated by install.sh) -------------------------------------
# Signs session tokens. At least 32 bytes. Changing it signs everyone out.
ARTEL_JWT_SECRET=__GENERATE_ARTEL_JWT_SECRET__
# Encrypts the OpenRouter key stored from the admin page. Required for the admin page to save a key.
# Never change it after first start: a changed value makes the saved key unreadable.
ARTEL_SECRETS_KEY=__GENERATE_ARTEL_SECRETS_KEY__

# ---- Accounts --------------------------------------------------------------
# The first account to sign up becomes the admin. After that, public signup is closed
# unless this is true. The admin can always create accounts from the admin page.
ARTEL_SIGNUP_OPEN=false
# GitHub sign-in admits only existing users (and accounts an admin created with the same email)
# when false. Only matters if the GitHub variables below are set.
ARTEL_GITHUB_SIGNUP_OPEN=false
# Login rate limit: failures per email or per client address inside the window before a 429.
ARTEL_LOGIN_MAX_FAILURES=10
ARTEL_LOGIN_FAILURE_WINDOW=PT15M
# Per-address limit. Behind Docker's userland proxy every client appears as one bridge address, so this
# works as a global brake on wrong passwords rather than a per-client limit.
ARTEL_LOGIN_ADDRESS_MAX_FAILURES=100

# ---- LLM key ---------------------------------------------------------------
# Optional. A single OpenRouter key covers every model. The admin page can set it instead,
# and the admin page value wins over this variable.
OPENROUTER_API_KEY=

# ---- GitHub login (optional) ----------------------------------------------
# Leave both blank to hide the GitHub login button. Both must be set to show it.
# OAuth callback to register: <ARTEL_PUBLIC_URL>/login/oauth2/code/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Bedrock (optional, not needed) ---------------------------------------
# A default install never calls Bedrock. Set only if you use a bedrock/... model.
BEDROCK_API_KEY=

# ---- PostgreSQL ------------------------------------------------------------
DB_NAME=artel
DB_USERNAME=artel
DB_PASSWORD=__GENERATE_DB_PASSWORD__

# ---- Object storage (MinIO) ------------------------------------------------
# These two are also the MinIO root login. install.sh generates them.
ARTEL_S3_ACCESS_KEY=__GENERATE_ARTEL_S3_ACCESS_KEY__
ARTEL_S3_SECRET_KEY=__GENERATE_ARTEL_S3_SECRET_KEY__
# Bucket created at start. The proxy routes /<bucket>/ to MinIO, so the name must not equal a
# route of the product: api, oauth2, login, ws, admin, assets, projects, account. install.sh checks it.
ARTEL_S3_BUCKET=artel
ARTEL_S3_REGION=us-east-1
# There is no separate S3 address to set. The server signs presigned URLs for ARTEL_PUBLIC_URL, so the
# browser uploads and downloads through the same origin (the proxy forwards /<bucket>/ to MinIO) and
# no MinIO port is published on the host.
# Image overrides. Docker Hub no longer serves minio/minio, so the defaults are Chainguard builds.
# ARTEL_MINIO_IMAGE=cgr.dev/chainguard/minio:latest
# ARTEL_MINIO_CLIENT_IMAGE=cgr.dev/chainguard/minio-client:latest
